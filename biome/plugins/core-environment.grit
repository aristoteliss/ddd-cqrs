engine biome(1.0)
language js(typescript)

// AGENTS.md rule 3: packages read no environment. Configuration comes in through
// options and constructor arguments, which the application fills from its own
// configuration module.
//
// A `process.env` read in a shared helper is worse than one in a module: it is
// invisible at the call site, it cannot be overridden by any later configuration
// when evaluated at module load, and it makes behavior depend on how the process
// happened to be started. Where such a value changes a security decision — for
// example which tenant namespace a cache key lands in — a missing variable turns
// into a silent isolation failure rather than a startup error.
//
// Scoped in biome.json to every package.

JsStaticMemberExpression(object=$object, member=$member) as $access where {
  $object <: `process`,
  $member <: `env`,
  register_diagnostic(span=$access, message="Do not read process.env in shared library or DDD core code. Resolve configuration in the composition root and pass it in through a module option or an application port, so the dependency is visible and overridable. Where the value guards tenant or principal isolation, fail closed on absence instead of substituting a default.", severity="error")
}
