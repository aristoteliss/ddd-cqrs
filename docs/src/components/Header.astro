---
// The theme's header, plus a highlight on the top bar link of the section the page is in.
// A page's section is the first segment of its path (overview, concepts, api, ...), and a top bar
// link belongs to the section its URL points into.
import NovaHeader from 'starlight-theme-nova/components/Header.astro';

const { id, locale } = Astro.locals.starlightRoute;
const path = locale ? id.slice(locale.length + 1) : id;
const section = path.split('/')[0];

const { pathname } = Astro.url;
const prefix =
  section &&
  pathname.slice(0, pathname.indexOf(`/${section}/`) + section.length + 2);
---

<NovaHeader />

{
  prefix && (
    <style
      is:inline
      set:html={`header > div > nav a[href^="${prefix}"] { color: var(--sl-color-white); text-decoration: underline 2px var(--sl-color-accent); text-underline-offset: 0.5rem; }`}
    />
  )
}
