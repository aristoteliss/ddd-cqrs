{
  "name": "@cqrs-ddd/pipeline-rate-limit",
  "version": "0.5.0",
  "description": "Rate limiting for @cqrs-ddd/pipeline, with keys partitioned by tenant, principal and operation",
  "author": "Aristotelis",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "pipeline",
    "cqrs",
    "rate-limit",
    "rate-limiter",
    "throttle",
    "rate-limiter-flexible",
    "redis",
    "ddos",
    "behavior"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aristoteliss/ddd-cqrs.git",
    "directory": "packages/pipeline-rate-limit"
  },
  "homepage": "https://aristoteliss.github.io/ddd-cqrs/packages/pipeline-rate-limit/",
  "bugs": {
    "url": "https://github.com/aristoteliss/ddd-cqrs/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "default": "./dist/http.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "COMMERCIAL_LICENSE.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "rebuild": "pnpm run clean && pnpm run build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run rebuild"
  },
  "peerDependencies": {
    "@cqrs-ddd/pipeline": "workspace:^"
  },
  "devDependencies": {
    "@cqrs-ddd/pipeline": "workspace:*",
    "@vitest/coverage-v8": "^5.0.3",
    "rate-limiter-flexible": "^11.2.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@cqrs-ddd/safe-stringify": "workspace:^"
  }
}
