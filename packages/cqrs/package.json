{
  "name": "@cqrs-ddd/cqrs",
  "version": "0.5.0",
  "description": "Command, query and event buses with handler decorators, @UsePipeline and modules, the API of NestJS CQRS without NestJS",
  "author": "Aristotelis",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aristoteliss/ddd-cqrs.git",
    "directory": "packages/cqrs"
  },
  "homepage": "https://aristoteliss.github.io/ddd-cqrs/packages/cqrs/",
  "bugs": {
    "url": "https://github.com/aristoteliss/ddd-cqrs/issues"
  },
  "keywords": [
    "cqrs",
    "command-bus",
    "query-bus",
    "event-bus",
    "pipeline",
    "ddd"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "COMMERCIAL_LICENSE.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "rebuild": "pnpm run clean && pnpm run build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run rebuild"
  },
  "peerDependencies": {
    "@cqrs-ddd/pipeline": "workspace:^"
  },
  "devDependencies": {
    "@cqrs-ddd/pipeline": "workspace:*",
    "@vitest/coverage-v8": "^5.0.3",
    "vitest": "^5.0.3"
  }
}
