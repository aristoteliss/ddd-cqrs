{
  "name": "@cqrs-ddd/pipeline-casl",
  "version": "0.5.0",
  "description": "CASL authorization for @cqrs-ddd/pipeline: type-level checks before the handler, entity and field checks after it",
  "author": "Aristotelis",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aristoteliss/ddd-cqrs.git",
    "directory": "packages/pipeline-casl"
  },
  "homepage": "https://aristoteliss.github.io/ddd-cqrs/packages/pipeline-casl/",
  "bugs": {
    "url": "https://github.com/aristoteliss/ddd-cqrs/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "default": "./dist/http.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "COMMERCIAL_LICENSE.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "rebuild": "pnpm run clean && pnpm run build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run rebuild"
  },
  "dependencies": {
    "@cqrs-ddd/safe-stringify": "workspace:^"
  },
  "peerDependencies": {
    "@casl/ability": "^7.0.0",
    "@cqrs-ddd/pipeline": "workspace:^"
  },
  "devDependencies": {
    "@casl/ability": "^7.0.1",
    "@cqrs-ddd/pipeline": "workspace:*",
    "@vitest/coverage-v8": "^5.0.3",
    "vitest": "^5.0.3"
  },
  "keywords": []
}
