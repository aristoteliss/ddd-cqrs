{
  "name": "@cqrs-ddd/pipeline",
  "version": "0.5.0",
  "description": "Framework-neutral pipeline engine: wrap functions and methods with behaviors such as logging, caching or idempotency",
  "author": "Aristotelis",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aristoteliss/ddd-cqrs.git",
    "directory": "packages/pipeline"
  },
  "homepage": "https://aristoteliss.github.io/ddd-cqrs/packages/pipeline/",
  "bugs": {
    "url": "https://github.com/aristoteliss/ddd-cqrs/issues"
  },
  "keywords": [
    "pipeline",
    "behaviors",
    "cqrs",
    "ddd",
    "decorators",
    "middleware"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "COMMERCIAL_LICENSE.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "rebuild": "pnpm run clean && pnpm run build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run rebuild"
  },
  "dependencies": {
    "@cqrs-ddd/safe-stringify": "workspace:^",
    "@cqrs-ddd/untyped": "workspace:^",
    "@cqrs-ddd/uuidv7": "workspace:^"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.3",
    "vitest": "^5.0.3"
  }
}
