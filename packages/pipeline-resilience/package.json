{
  "name": "@cqrs-ddd/pipeline-resilience",
  "version": "0.5.0",
  "description": "Retry, timeout, circuit breaker, bulkhead and fallback policies (cockatiel) for @cqrs-ddd/pipeline",
  "author": "Aristotelis",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "cqrs",
    "pipeline",
    "resilience",
    "fault-tolerance",
    "retry",
    "circuit-breaker",
    "timeout",
    "bulkhead",
    "fallback",
    "cockatiel"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aristoteliss/ddd-cqrs.git",
    "directory": "packages/pipeline-resilience"
  },
  "homepage": "https://aristoteliss.github.io/ddd-cqrs/packages/pipeline-resilience/",
  "bugs": {
    "url": "https://github.com/aristoteliss/ddd-cqrs/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "COMMERCIAL_LICENSE.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "rebuild": "pnpm run clean && pnpm run build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run rebuild"
  },
  "peerDependencies": {
    "@cqrs-ddd/pipeline": "workspace:^",
    "cockatiel": "^4.0.0"
  },
  "devDependencies": {
    "@cqrs-ddd/pipeline": "workspace:*",
    "@vitest/coverage-v8": "^5.0.3",
    "cockatiel": "^4.0.0",
    "vitest": "^5.0.3"
  }
}
