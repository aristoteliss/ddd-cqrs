{
  "name": "@cqrs-ddd/pipeline-cache",
  "version": "0.5.0",
  "description": "Result caching for @cqrs-ddd/pipeline on cache-manager and Keyv stores, with keys partitioned by tenant, principal and permission scope",
  "author": "Aristotelis",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "pipeline",
    "cqrs",
    "cache",
    "caching",
    "cache-manager",
    "keyv",
    "redis",
    "behavior"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aristoteliss/ddd-cqrs.git",
    "directory": "packages/pipeline-cache"
  },
  "homepage": "https://aristoteliss.github.io/ddd-cqrs/packages/pipeline-cache/",
  "bugs": {
    "url": "https://github.com/aristoteliss/ddd-cqrs/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "COMMERCIAL_LICENSE.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "rebuild": "pnpm run clean && pnpm run build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run rebuild"
  },
  "peerDependencies": {
    "@cqrs-ddd/pipeline": "workspace:^",
    "@keyv/memcache": "^2.0.0",
    "@keyv/postgres": "^2.0.0",
    "@keyv/redis": "^4.0.0 || ^5.0.0",
    "@keyv/sqlite": "^4.0.0",
    "cache-manager": "^7.0.0",
    "keyv": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@keyv/memcache": {
      "optional": true
    },
    "@keyv/postgres": {
      "optional": true
    },
    "@keyv/redis": {
      "optional": true
    },
    "@keyv/sqlite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cqrs-ddd/pipeline": "workspace:*",
    "@vitest/coverage-v8": "^5.0.3",
    "cache-manager": "^7.2.9",
    "keyv": "^5.6.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@cqrs-ddd/safe-stringify": "workspace:^"
  }
}
