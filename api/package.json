{
  "name": "ddd-cqrs-api",
  "private": true,
  "version": "0.5.0",
  "description": "The users API on @cqrs-ddd: Express and Fastify routes with Zod, the CQRS buses and pipelines, DDD aggregates and decorated repositories",
  "homepage": "https://aristoteliss.github.io/ddd-cqrs/guides/http/#in-the-example-application",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "pnpm build && node dist/main.js",
    "start:fastify": "pnpm build && ADAPTER=fastify node dist/main.js",
    "test": "pnpm build && vitest run",
    "db:migrate": "pnpm build && node dist/persistence/cli.js migrate",
    "db:revert": "pnpm build && node dist/persistence/cli.js revert",
    "permissions:rebuild": "pnpm build && node dist/persistence/cli.js permissions:rebuild",
    "permissions:verify": "pnpm build && node dist/persistence/cli.js permissions:verify",
    "sessions:purge": "pnpm build && node dist/persistence/cli.js sessions:purge",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "openapi": "pnpm build && node dist/openapi.js"
  },
  "dependencies": {
    "@casl/ability": "^7.0.1",
    "@cqrs-ddd/core": "workspace:*",
    "@cqrs-ddd/cqrs": "workspace:*",
    "@cqrs-ddd/mikro-orm": "workspace:*",
    "@cqrs-ddd/pipeline": "workspace:*",
    "@cqrs-ddd/pipeline-audit": "workspace:*",
    "@cqrs-ddd/pipeline-cache": "workspace:*",
    "@cqrs-ddd/pipeline-casl": "workspace:*",
    "@cqrs-ddd/pipeline-correlation": "workspace:*",
    "@cqrs-ddd/pipeline-deadletter": "workspace:*",
    "@cqrs-ddd/pipeline-feature-flags": "workspace:*",
    "@cqrs-ddd/pipeline-idempotency": "workspace:*",
    "@cqrs-ddd/pipeline-job-context": "workspace:*",
    "@cqrs-ddd/pipeline-opentelemetry": "workspace:*",
    "@cqrs-ddd/pipeline-rate-limit": "workspace:*",
    "@cqrs-ddd/pipeline-resilience": "workspace:*",
    "@cqrs-ddd/pipeline-tenant": "workspace:*",
    "@cqrs-ddd/pipeline-zod": "workspace:*",
    "@cqrs-ddd/safe-stringify": "workspace:*",
    "@cqrs-ddd/uuidv7": "workspace:*",
    "@fastify/secure-session": "^8.4.0",
    "@keyv/redis": "^5.1.6",
    "@mikro-orm/core": "^7.2.3",
    "@mikro-orm/libsql": "^7.2.3",
    "@mikro-orm/migrations": "^7.2.3",
    "@mikro-orm/postgresql": "^7.2.3",
    "@mikro-orm/sql": "^7.2.3",
    "@openfeature/server-sdk": "^1.23.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.222.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-pg": "^0.74.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "bullmq": "^5.81.5",
    "cache-manager": "^7.2.9",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "keyv": "^5.6.0",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "rate-limiter-flexible": "^11.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@libsql/client": "^0.18.0",
    "@redis/client": "^6.3.0",
    "@testcontainers/redis": "^12.2.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.0",
    "vitest": "^5.0.3"
  }
}
