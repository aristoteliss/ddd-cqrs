# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Runtime
node_modules/
dist/
build/
.cache/
.tmp/

# Coverage
coverage/
*.lcov

# The api's local libSQL databases
api/src/persistence/*.db
api/src/persistence/*.db-*

# Environment
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo

# Generated only during package tarball creation
packages/*/LICENSE
packages/*/COMMERCIAL_LICENSE.txt

# Editor
.vscode/settings.json
.idea/
*.swp
*.swo

# AI assistant workspace: the context files, scripts and codebase map are shared;
# only machine-local settings, active task files, launch drafts and generator caches stay out.
.claude/settings.local.json
.claude/tasks/*
!.claude/tasks/TEMPLATE.md
.claude/launch/
.claude/state/
__pycache__/

# Documentation site: Astro cache and generated pages
docs/.astro/
docs/src/content/docs/api/
# internal notes and drafts: private until the owner publishes them
docs/internal/

# Archify: the local skill toolchain and its build receipts stay out; the diagrams are tracked
.archify/skills/
.archify/**/*.finalize*.json
.archify/**/*.browser-check.json
.archify/**/*.delivery*.json
