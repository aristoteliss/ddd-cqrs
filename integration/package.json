{
  "name": "ddd-cqrs-integration",
  "private": true,
  "version": "0.5.0",
  "description": "Repository-wide checks and applications built on the packages one at a time: the Biome Grit plugin specs, the release verification, cross-package pipeline contracts, a pipeline-only payments service, a domain-only library, MikroORM repositories, a plain Node.js module, standard decorators and a NestJS application on the adapter, tested over HTTP",
  "type": "module",
  "scripts": {
    "lint": "tsc --noEmit && tsc -p standard-decorators/tsconfig.json --noEmit",
    "test": "vitest run && node --test \"plain-node/*.test.mjs\" && tsc -p standard-decorators/tsconfig.json && node --test \"standard-decorators/dist/*.test.js\""
  },
  "devDependencies": {
    "@cqrs-ddd/core": "workspace:*",
    "@cqrs-ddd/cqrs": "workspace:*",
    "@cqrs-ddd/mikro-orm": "workspace:*",
    "@cqrs-ddd/nestjs": "workspace:*",
    "@cqrs-ddd/pipeline": "workspace:*",
    "@cqrs-ddd/pipeline-audit": "workspace:*",
    "@cqrs-ddd/pipeline-cache": "workspace:*",
    "@cqrs-ddd/pipeline-casl": "workspace:*",
    "@cqrs-ddd/pipeline-correlation": "workspace:*",
    "@cqrs-ddd/pipeline-deadletter": "workspace:*",
    "@cqrs-ddd/pipeline-feature-flags": "workspace:*",
    "@cqrs-ddd/pipeline-idempotency": "workspace:*",
    "@cqrs-ddd/pipeline-rate-limit": "workspace:*",
    "@cqrs-ddd/pipeline-resilience": "workspace:*",
    "@cqrs-ddd/pipeline-tenant": "workspace:*",
    "@cqrs-ddd/pipeline-zod": "workspace:*",
    "@mikro-orm/core": "^7.2.3",
    "@mikro-orm/libsql": "^7.2.3",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/cqrs": "^12.1.0",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/platform-fastify": "^12.1.2",
    "@openfeature/server-sdk": "^1.23.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.3",
    "cache-manager": "^7.2.9",
    "keyv": "^5.6.0",
    "rate-limiter-flexible": "^11.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.3.1",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  }
}
